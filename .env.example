# Gmail Manager Environment Variables Template
# Copy this file to .env and fill in your actual values

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Session Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET_KEY=your_64_char_hex_secret_here

# AI Provider API Keys

# Groq API Keys (get from: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_key_here
GROQ_API_KEY_1=your_groq_key_1_here
GROQ_API_KEY_2=your_groq_key_2_here
# Add more as needed (up to GROQ_API_KEY_9)

# Gemini API Keys (get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_KEY_1=your_gemini_key_1_here
# Add more as needed (up to GEMINI_API_KEY_17)

# Cohere API Key (optional, for rewriting) - https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_key_here

# NVIDIA API Key (optional, for classification) - https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_key_here

# Database Configuration
# For production (Railway), set DATABASE_URL in Railway dashboard
# For local development, leave empty to use SQLite
# DATABASE_URL=postgresql://user:password@host:port/database

# Redis Configuration (optional - for distributed caching in future)
# REDIS_URL=redis://localhost:6379

# Deployment Configuration
ALLOWED_ORIGIN=https://gmail-manager-gamma.vercel.app
FRONTEND_URL=https://gmail-manager-gamma.vercel.app

# Force SQLite (for local development only)
FORCE_SQLITE=false
